# WMS demo instance B
# Replace every "change-this" value before exposing it publicly.
MYSQL_ROOT_PASSWORD=change-this-demo-b-database-password
MYSQL_DATABASE=gowms_demo_b
JWT_SECRET=change-this-demo-b-jwt-secret-with-at-least-32-characters
WMS_INTEGRATION_API_KEY=change-this-demo-b-integration-api-key
WMS_SERVER_NODE=12
WMS_API_BIND=127.0.0.1
WMS_API_PORT=18090
WMS_WEB_PORT=18082
WMS_SERVER_TRUSTED_PROXIES=172.16.0.0/12
WMS_SERVER_BODY_LIMIT_MB=10
WMS_SERVER_CORS_ALLOW_ORIGINS=
WMS_METRICS_ENABLED=true
WMS_METRICS_PORT=9090
WMS_METRICS_PATH=/metrics
WMS_PROMETHEUS_PORT=9092
WMS_GRAFANA_PORT=3002
WMS_GRAFANA_ADMIN_USER=admin
WMS_GRAFANA_ADMIN_PASSWORD=change-this-demo-b-grafana-password
WMS_DEMO_ENABLED=true
WMS_DEMO_USERNAME=demo-b
WMS_DEMO_PASSWORD=change-this-demo-b-password
WMS_DEMO_SESSION_TTL_SECONDS=300
# GoWMS demo instance A
# Replace every "change-this" value before exposing it publicly.
MYSQL_ROOT_PASSWORD=change-this-demo-a-database-password
MYSQL_DATABASE=gowms_demo_a
JWT_SECRET=change-this-demo-a-jwt-secret-with-at-least-32-characters
WMS_INTEGRATION_API_KEY=change-this-demo-a-integration-api-key
WMS_SERVER_NODE=11
WMS_API_BIND=127.0.0.1
WMS_API_PORT=18080
WMS_WEB_PORT=18081
WMS_SERVER_TRUSTED_PROXIES=172.16.0.0/12
WMS_SERVER_BODY_LIMIT_MB=10
WMS_SERVER_CORS_ALLOW_ORIGINS=
WMS_METRICS_ENABLED=true
WMS_METRICS_PORT=9090
WMS_METRICS_PATH=/metrics
WMS_PROMETHEUS_PORT=9091
WMS_GRAFANA_PORT=3001
WMS_GRAFANA_ADMIN_USER=admin
WMS_GRAFANA_ADMIN_PASSWORD=change-this-demo-a-grafana-password
WMS_DEMO_ENABLED=true
WMS_DEMO_USERNAME=demo-a
WMS_DEMO_PASSWORD=change-this-demo-a-password
WMS_DEMO_SESSION_TTL_SECONDS=300
# WMS Docker Compose environment variables.
# start.ps1 creates .env automatically and replaces these placeholders with random values.
MYSQL_ROOT_PASSWORD=change-this-database-password
# Database name keeps the legacy identifier "gowms" (internal only, unrelated to the WMS display name).
# Renaming it requires updating the DSN in configs/config.yaml as well.
MYSQL_DATABASE=gowms
JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters
WMS_INTEGRATION_API_KEY=change-this-integration-api-key
WMS_INTEGRATION_TENANT_ID=0
# 平台管理员初始密码：release 首次部署创建内置管理员时必须设置，留空会启动失败；
# 使用 scripts/windows/start.ps1 生成 .env 时会自动填入随机密码并打印到终端。
WMS_ADMIN_PASSWORD=
WMS_SERVER_NODE=1
WMS_API_BIND=127.0.0.1
WMS_API_PORT=8080
# 服务器上改为 WMS_WEB_BIND=127.0.0.1 + WMS_WEB_PORT=8081：web 只监听回环，把 80/443 让给 Caddy 容器。
# 本地开发保持默认（web 监听 0.0.0.0:80），不启动 Caddy。
WMS_WEB_BIND=0.0.0.0
WMS_WEB_PORT=80
# HTTPS（仅服务器需要，配合 docker compose --profile tls 启用 Caddy 自动签发证书）
# 域名需已把 A 记录解析到本机公网 IP，且安全组已放行 80/443，否则证书签发会失败。
WMS_SITE_DOMAIN=wms.example.com
WMS_ACME_EMAIL=admin@example.com
WMS_SERVER_TRUSTED_PROXIES=172.16.0.0/12
WMS_SERVER_BODY_LIMIT_MB=10
WMS_SERVER_CORS_ALLOW_ORIGINS=
WMS_METRICS_ENABLED=true
WMS_METRICS_PORT=9090
WMS_PROMETHEUS_PORT=9090
WMS_METRICS_PATH=/metrics
WMS_GRAFANA_PORT=3000
WMS_GRAFANA_ADMIN_USER=admin
WMS_GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
WMS_DEMO_ENABLED=true
WMS_DEMO_INSTANCES=5
# 演示账号共用密码：release 开启演示功能时必须显式设置（存在开发默认值，仅 debug/本地脚本使用）。
WMS_DEMO_PASSWORD=
# 持久体验账号（user1..userN）：与演示账号同构但数据长期保留（不重置），登录页由访客自行挑选账号
WMS_PERSONAL_ENABLED=true
WMS_PERSONAL_INSTANCES=3
# 持久账号共用密码：release 开启时必须显式设置（存在开发默认值，仅 debug/本地脚本使用）。
WMS_PERSONAL_PASSWORD=
# LLM (Zhipu BigModel) — get a free API key at https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_LLM_MODEL=glm-4.7-flash
ZHIPU_LLM_BACKUP_MODEL=glm-4-flash-250414
WMS_DEMO_SESSION_TTL_SECONDS=300
